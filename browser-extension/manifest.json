{
  "manifest_version": 3,
  "name": "MQTT Live Monitor",
  "version": "0.2.2",
  "description": "Schnellansicht fuer ausgewaehlte MQTT Live Monitor Werte.",
  "action": {
    "default_title": "MQTT Live Monitor",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "windows"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
